{
  "name": "farmotic",
  "version": "2.1.0",
  "private": true,
  "description": "Farmotic - suivi d'elevage de poulets de chair",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,interface -c green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python3 lancer.py --dev --no-open",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
